# kona-vulkan: Fedora with the Mesa build that works with krunkit's Venus
# (COPR slp/mesa-libkrun-vulkan, pinned; docs/gpu.md). Base for the DRA
# driver and the examples: workloads must bring this Mesa, since upstream
# Fedora/Ubuntu Mesa fails vkCreateInstance under krunkit.
ARG FEDORA_DIGEST
FROM docker.io/library/fedora:44@${FEDORA_DIGEST}
ARG MESA_VERSION
RUN dnf -y install --setopt=install_weak_deps=False dnf-plugins-core python3-dnf-plugin-versionlock \
 && dnf -y copr enable slp/mesa-libkrun-vulkan \
 && dnf -y install --setopt=install_weak_deps=False \
      "mesa-vulkan-drivers-${MESA_VERSION}" "mesa-filesystem-${MESA_VERSION}" vulkan-tools vulkan-loader \
 && dnf versionlock add "mesa-vulkan-drivers-${MESA_VERSION}" "mesa-filesystem-${MESA_VERSION}" \
 && find /usr/share/vulkan/icd.d -name '*.json' ! -name 'virtio_icd.*' ! -name 'lvp_icd.*' -delete \
 && dnf clean all
