# kona node image for Apple `container` (k3s distro).
# Same distro base as the krunkit GPU node image (Fedora), so both node
# kinds share userland. Versions are passed from versions.env by the Makefile.
ARG FEDORA_DIGEST
FROM docker.io/library/fedora:44@${FEDORA_DIGEST}

ARG K3S_VERSION
ARG K3S_SHA256
ARG K3S_AIRGAP_SHA256

RUN dnf -y install --setopt=install_weak_deps=False \
      ca-certificates chrony conntrack-tools ethtool iproute iptables-nft \
      iputils kmod nftables procps-ng util-linux wireguard-tools zstd \
 && dnf clean all \
 && sed -i 's/^makestep .*/makestep 1 -1/' /etc/chrony.conf
# ^ step the clock whenever it is >1s off, not only at boot: guest clocks
#   stop while the host sleeps.

# k3s bundles containerd, runc, flannel and the CNI plugins.
RUN set -eu; v=$(printf %s "$K3S_VERSION" | sed 's/+/%2B/'); \
    base=https://github.com/k3s-io/k3s/releases/download/$v; \
    curl -fsSL -o /usr/local/bin/k3s "$base/k3s-arm64"; \
    echo "$K3S_SHA256  /usr/local/bin/k3s" | sha256sum -c -; \
    chmod 0755 /usr/local/bin/k3s; \
    for l in kubectl crictl ctr; do ln -s k3s /usr/local/bin/$l; done; \
    mkdir -p /var/lib/rancher/k3s/agent/images; \
    curl -fsSL -o /var/lib/rancher/k3s/agent/images/k3s-airgap-images-arm64.tar.zst \
      "$base/k3s-airgap-images-arm64.tar.zst"; \
    echo "$K3S_AIRGAP_SHA256  /var/lib/rancher/k3s/agent/images/k3s-airgap-images-arm64.tar.zst" | sha256sum -c -

COPY kona-node /usr/local/bin/kona-node
RUN chmod 0755 /usr/local/bin/kona-node

ENTRYPOINT ["/usr/local/bin/kona-node"]
