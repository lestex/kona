#!/bin/bash
# Bring wg0 to the state described by /etc/kona/wg0.conf and
# /etc/kona/wg-routes. Idempotent: kona re-runs it whenever peers change,
# and node boot runs it when the files exist.
#
# wg0.conf is `wg setconf` format (no Address/DNS lines). wg-routes holds one
# destination prefix per line to route via wg0 (the other network's /24).
# WireGuard only links the `container` network and the krunkit GPU network;
# node-to-node traffic within a network never touches it
# (docs/networking.md).
set -euo pipefail

conf=/etc/kona/wg0.conf
routes=/etc/kona/wg-routes
mtu=${KONA_WG_MTU:-1420}

[ -f "$conf" ] || exit 0

if ! ip link show wg0 >/dev/null 2>&1; then
  ip link add wg0 type wireguard
fi
wg setconf wg0 "$conf"
ip link set wg0 mtu "$mtu" up

if [ -f "$routes" ]; then
  src=$(ip -4 -o addr show dev eth0 | awk '{print $4}' | cut -d/ -f1 | head -1)
  while read -r prefix; do
    [ -n "$prefix" ] || continue
    # src pins replies to the node's static (primary) address.
    ip route replace "$prefix" dev wg0 src "$src"
  done < "$routes"
fi
