# llama.cpp with its Vulkan backend on top of kona-vulkan (the Mesa that
# works with krunkit's Venus), plus a small model baked in so the example
# runs offline. Every download is pinned by sha256 (versions.env).
ARG VULKAN_IMAGE
FROM ${VULKAN_IMAGE} AS build
ARG LLAMA_CPP_VERSION
ARG LLAMA_CPP_SHA256
ARG LLAMA_MODEL_URL
ARG LLAMA_MODEL_SHA256
RUN dnf -y install --setopt=install_weak_deps=False \
      cmake gcc-c++ make vulkan-loader-devel vulkan-headers spirv-headers-devel glslc \
 && dnf clean all
RUN curl -fsSL -o /llama.tar.gz "https://github.com/ggml-org/llama.cpp/archive/refs/tags/${LLAMA_CPP_VERSION}.tar.gz" \
 && echo "${LLAMA_CPP_SHA256}  /llama.tar.gz" | sha256sum -c - \
 && mkdir /src && tar xzf /llama.tar.gz -C /src --strip-components=1
RUN cmake -S /src -B /build -DCMAKE_BUILD_TYPE=Release -DGGML_VULKAN=ON -DGGML_NATIVE=OFF -DGGML_CCACHE=OFF \
      -DBUILD_SHARED_LIBS=OFF -DLLAMA_OPENSSL=OFF -DLLAMA_BUILD_TESTS=OFF -DLLAMA_BUILD_EXAMPLES=OFF \
      -DLLAMA_BUILD_SERVER=OFF \
 && cmake --build /build -j"$(nproc)" --target llama-completion llama-bench
RUN curl -fsSL -o /model.gguf "${LLAMA_MODEL_URL}" \
 && echo "${LLAMA_MODEL_SHA256}  /model.gguf" | sha256sum -c -

FROM ${VULKAN_IMAGE}
COPY --from=build /build/bin/llama-completion /build/bin/llama-bench /usr/local/bin/
COPY --from=build /model.gguf /models/model.gguf
