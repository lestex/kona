#version 450
// d[i] = d[i] * 2 + 1 for every element; 256 invocations per workgroup.
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Data { uint d[]; };
layout(push_constant) uniform Push { uint n; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < n) {
        d[i] = d[i] * 2u + 1u;
    }
}
