# kona-venus-dra: the DRA kubelet plugin on top of kona-vulkan (it runs
# vulkaninfo to discover the Venus device).
ARG GOLANG_DIGEST
ARG VULKAN_IMAGE
FROM docker.io/library/golang:1.26.8@${GOLANG_DIGEST} AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /kona-venus-dra ./cmd/kona-venus-dra

FROM ${VULKAN_IMAGE}
COPY --from=build /kona-venus-dra /usr/local/bin/kona-venus-dra
ENTRYPOINT ["/usr/local/bin/kona-venus-dra"]
