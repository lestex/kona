# kona kernel fragment, merged on top of base-arm64.config (Apple container's
# default 6.18.35 kernel, extracted from /proc/config.gz).
# Every option below is documented in docs/kernel.md. The base kernel is
# monolithic (CONFIG_MODULES=n), so everything is built in.

# tc/eBPF datapath (Cilium attaches to clsact via tcx/tc)
CONFIG_NET_CLS_ACT=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y
CONFIG_NET_SCH_INGRESS=y

# Cilium: netkit devices, socket-LB/TPROXY match, sha1 for bpf hashing, stats
CONFIG_NETKIT=y
CONFIG_NETFILTER_XT_MATCH_SOCKET=y
CONFIG_CRYPTO_SHA1=y
CONFIG_SCHEDSTATS=y

# Cilium kube-proxy replacement terminates sockets connected to deleted
# service backends via sock_diag (SOCK_DESTROY). Without these the agent
# logs "failed while iterating sockets" and stale UDP flows (e.g. DNS to a
# removed CoreDNS pod) are never reset. Found by `cilium connectivity test`.
CONFIG_INET_DIAG=y
CONFIG_INET_TCP_DIAG=y
CONFIG_INET_UDP_DIAG=y
CONFIG_INET_DIAG_DESTROY=y

# Overlays and encryption
CONFIG_GENEVE=y
CONFIG_WIREGUARD=y

# kube-proxy IPVS mode creates the kube-ipvs0 dummy interface
CONFIG_DUMMY=y
