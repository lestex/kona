# Pinned versions for every kona component.
# Embedded into the kona binary via -ldflags (see Makefile) so `kona version`
# prints the full matrix. Change a version here, and only here.

# Kubernetes
KUBERNETES_VERSION=v1.34.12
K3S_VERSION=v1.34.11+k3s1
CONTAINERD_VERSION=v2.4.1
RUNC_VERSION=v1.5.1
CNI_PLUGINS_VERSION=v1.9.1
ETCD_VERSION=v3.6.15
CILIUM_VERSION=v1.20.2
CILIUM_CLI_VERSION=v0.20.1
SONOBUOY_VERSION=v0.57.5

# Host tools (minimum supported, checked by `kona doctor`)
CONTAINER_VERSION=1.4.1
KRUNKIT_VERSION=1.3.2
LIBKRUN_VERSION=1.19.5
VMNET_HELPER_VERSION=0.13.0

# Guests
KERNEL_VERSION=6.18.35
MESA_VERSION=26.2.3
FEDORA_VERSION=44
